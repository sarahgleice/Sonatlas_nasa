# SONATLAS - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Frontend Configuration
VITE_APP_TITLE=SONATLAS - Explore Earth Through Sound
VITE_DATA_BASE_PATH=/data
VITE_ENABLE_AUDIO_DEBUG=false

# Processing Configuration (Python)
# NASA Earthdata Login Credentials (Required only for downloading original HDF5/NetCDF files via GES DISC)
EARTHDATA_USERNAME=your_username_here
EARTHDATA_PASSWORD=your_password_here

# Paths
RAW_DATA_DIR=./processing/data/raw
PROCESSED_DATA_DIR=./processing/data/processed
EXPORT_JSON_DIR=./frontend/public/data
